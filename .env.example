# DeepKey environment
# Copy to .env and adjust. Never put real secrets here.

DEEPKEY_DATA_DIR=/data
DEEPKEY_HOST=0.0.0.0
DEEPKEY_PORT=8787

# Public URL of this instance. Required behind HTTPS reverse proxies.
# DEEPKEY_PUBLIC_URL=https://deepkey.example.com

# Trust X-Forwarded-* headers only when running behind a reverse proxy you control.
DEEPKEY_TRUST_PROXY=false
